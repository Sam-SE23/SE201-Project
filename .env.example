# Copy to .env and edit. Each component is "stub" or "real".
# "real" loads the teammate's module (see backend/registry.py) and falls back
# to the stub, with a warning in the UI, if it isn't ready yet.
STUDY_BUDDY_LLM=stub
# real = Chroma + local embeddings (first run downloads the model)
STUDY_BUDDY_RETRIEVER=stub
# real = grounded QA engine; needs STUDY_BUDDY_LLM=real for real answers
STUDY_BUDDY_QA=stub
STUDY_BUDDY_QUIZ=stub

# API keys for the real LLM, once the provider is chosen:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
