# Copy to .env and edit. Each component is "stub" or "real".
# "real" loads the teammate's module (see backend/registry.py) and falls back
# to the stub, with a warning in the UI, if it isn't ready yet.
STUDY_BUDDY_LLM=stub
# real = Chroma + local embeddings (first run downloads the model)
STUDY_BUDDY_RETRIEVER=stub
# real = grounded QA engine; needs STUDY_BUDDY_LLM=real for real answers
STUDY_BUDDY_QA=stub
STUDY_BUDDY_QUIZ=stub

# Real LLM (STUDY_BUDDY_LLM=real), called through LiteLLM.
# Local Ollama model: "ollama_chat/<tag>", where <tag> is what `ollama list` shows.
# Hosted model: "<provider>/<model>", e.g. "anthropic/claude-haiku-5-5",
# plus its key in STUDY_BUDDY_LLM_API_KEY below.
STUDY_BUDDY_LLM_MODEL=
# API key for a hosted model, whichever the provider. Leave empty for Ollama.
STUDY_BUDDY_LLM_API_KEY=
# Context window in tokens. Ollama's default is small and silently cuts the start
# of long prompts (the grounding rules), so keep this at 8192 or more.
STUDY_BUDDY_LLM_NUM_CTX=8192
# Seconds to wait for one answer before giving up.
STUDY_BUDDY_LLM_TIMEOUT=120
# 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and waits ~2 s per call.
OLLAMA_API_BASE=http://127.0.0.1:11434
